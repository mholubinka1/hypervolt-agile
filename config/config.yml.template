octopus:
  account_number:
  api_key:
hypervolt:
  username:
  password:
schedule:
  poll_every_secs: 10
  update_every_mins: 30
  total_charge_duration: 3
  price_limit_incl_vat: 30
# led:
#   enabled: true                  # Set to false to pause LED control without losing config. Omit the whole `led:` block to disable entirely.
#                                  # A displaying theme is always shown at full brightness; when nothing is displaying the LEDs are off. There is no brightness setting.
#   built_in_themes:                # Native charger effects, priority under custom_themes and extensions. Listing an effect here is what enables it -- omit one entirely to leave it off. Dates use MM-DD, or "MM-DD HH:MM" for a specific time (default 00:00).
#     - effect: halloween_mode
#       start: "10-31"
#       end: "11-01 06:00"
#       always_on: false              # Optional, default false. false: light the charger only while the car is actively charging. true: light it for the whole start..end window regardless of charge or plug state.
#     - effect: christmas_mode
#       start: "12-24"
#       end: "12-31 06:00"
#     - effect: party_mode
#       start: "12-31 06:00"
#       end: "01-01 06:00"
#   custom_themes:                 # Static colour patterns for dates that matter to you, priority over built-in seasonal effects. Colour maps live in this repo's themes/ directory (themes/<effect>.yaml, image content -- adding your own means forking/rebuilding). Preview and edit LED positions with themes/reference/charger_led_map.html. Add a matching entry here, e.g.:
#     - effect: my_theme              # themes/my_theme.yaml
#       start: "MM-DD"
#       end: "MM-DD"
#       always_on: false              # Optional, default false (see built_in_themes above).
#   extensions:                     # Dynamic themes resolved by a Python module you register, priority over custom_themes and built-ins. A saints_fc reference implementation ships in this repo's extensions/ -- to use it, copy extensions/saints_fc.py into a SEPARATE directory from config.yml (in Docker: /mnt/media/pi-media/containers/hypervolt-agile-scheduler/extensions/, mounted to /extensions -- see --extensions-dir) and uncomment the entry below.
#     - name: saints_fc                # extensions/saints_fc.py -- shows the tuned Southampton FC strip from 30 min before kick-off until 3 h after (always-on, outranks every theme); the rest of a match day it's a charging-only fallback below your custom/built-in themes.
#       config:
#         api_key: "3"                   # Optional, default "3" -- TheSportsDB's free shared key, no signup needed. Swap for a personal key (thesportsdb.com Patreon) for dedicated rate limits.
#         team_id: 134778                # Optional, default 134778 (Southampton FC) -- a TheSportsDB team ID, NOT football-data.org's
#         poll_interval_hours: 1         # Optional, default 1 -- how often (in hours, a positive number) to poll TheSportsDB for today's and tomorrow's fixtures. Today is also checked once on startup, so a same-day deploy/restart doesn't miss a match happening that day.
# threshold_extension:             # Optional, PHEV-only: replaces the static price_limit_incl_vat above with one recomputed from real fuel prices, so charging only happens when electricity is genuinely cheaper than fuel per mile. price_limit_incl_vat above stays required regardless -- it's the fallback used whenever this extension has no fresh answer (fuel price API down, no nearby stations, not yet polled, OAuth failure). A dynamic_charging_threshold reference implementation ships in this repo's extensions/behaviours/ -- to use it, copy extensions/behaviours/dynamic_charging_threshold.py into a SEPARATE directory from config.yml, preserving the behaviours/ subfolder (in Docker: /mnt/media/pi-media/containers/hypervolt-agile-scheduler/extensions/behaviours/, mounted to /extensions/behaviours -- see --extensions-dir), and uncomment the entry below.
#   name: behaviours/dynamic_charging_threshold   # extensions/behaviours/dynamic_charging_threshold.py -- computes breakeven price/kWh from local fuel price, mpg and electric efficiency, then applies a fixed 20% safety margin.
#   config:
#     fuel_type: petrol              # Required -- petrol or diesel. Maps to the GOV.UK Fuel Finder standard grade (petrol -> E10, diesel -> B7_STANDARD), not the premium variants.
#     mpg: 45.4609                   # Required -- your PHEV's approximate real-world miles-per-gallon on fuel alone.
#     mi_per_kwh: 3.5                # Optional, default 3.5 -- your PHEV's approximate real-world miles-per-kWh on electric alone (roughly 3.2-3.8 for most current PHEVs).
#     postcode: SW1A 1AA             # Required -- a GB postcode; fuel prices are averaged over the nearest stations to this postcode.
#     station_count: 5               # Required, no default -- how many of the nearest stations (that report your fuel_type) to average over. 5 is a reasonable starting value.
#     radius_miles: 10                # Optional -- an upper-bound cap on how far a station may be and still count towards station_count; it does NOT relax station_count if fewer matches are found within range, it only excludes anything further out.
#     client_id: your-fuel-finder-client-id         # Required -- from your own GOV.UK Fuel Finder developer registration (https://www.fuel-finder.service.gov.uk), not a shared app credential.
#     client_secret: your-fuel-finder-client-secret  # Required -- see client_id above. Keep this file's permissions restricted; it's a real secret.
#                                     # No separate poll-interval field here -- this extension re-polls on the same update_every_mins cadence set above under schedule:, since fuel prices move far less often than Agile electricity prices and don't need their own independent tuning.
# log_file: /logs/hypervolt-agile-scheduler.log   # Omit to log to console only. In Docker, /logs is bind-mounted from /mnt/media/pi-media/containers/hypervolt-agile-scheduler/log.
# log_level: INFO                # Console log level (default: INFO). File log level is always INFO.
