octopus:
  account_number:
  api_key:
hypervolt:
  username:
  password:
schedule:
  poll_every_secs: 10
  update_every_mins: 30
  total_charge_duration: 3
  price_limit_incl_vat: 30
# led:
#   enabled: true                  # Set to false to pause LED control without losing config. Omit the whole `led:` block to disable entirely.
#   brightness: 0.5                # >0 and <=1, LED brightness while charging (default: 0.5). LEDs always go fully off when not charging, regardless of this value.
#   custom_themes:                 # Static colour patterns for dates that matter to you, priority over built-in seasonal effects. Five ready-made examples ship in this repo's config/led_effects/ -- to use one, copy the matching *.yaml file into the SAME directory as your real config.yml (in Docker: /home/pi/.config/hypervolt-agile/led_effects/, since only config.yml itself is bind-mounted, these files are not baked into the image) and uncomment the matching entry below, or add your own led_effects/*.yaml and a matching entry.
#     - effect: peace               # led_effects/peace.yaml -- Ukraine flag colours
#       start: "02-24"
#       end: "02-25"
#     - effect: qe_ii                # led_effects/qe_ii.yaml -- Platinum Jubilee tribute
#       start: "06-02"
#       end: "06-05"
#     - effect: diana                # led_effects/diana.yaml -- Diana memorial tribute
#       start: "08-31"
#       end: "09-01"
#     - effect: st_george             # led_effects/st_george.yaml -- St George's Day
#       start: "04-23"
#       end: "04-24"
#     - effect: st_patricks           # led_effects/st_patricks.yaml -- St Patrick's Day
#       start: "03-17"
#       end: "03-18"
#   extensions:                     # Dynamic themes resolved by a Python module you register, priority over custom_themes and built-ins. A saints_fc reference implementation ships in this repo's extensions/ -- to use it, copy extensions/saints_fc.py into a SEPARATE directory from config.yml (in Docker: /home/pi/.config/hypervolt-agile-extensions/, mounted to /extensions -- see --extensions-dir) and uncomment the entry below.
#     - name: saints_fc                # extensions/saints_fc.py -- lights up red/white on any Southampton FC match day
#       config:
#         api_key: "3"                   # Optional, default "3" -- TheSportsDB's free shared key, no signup needed. Swap for a personal key (thesportsdb.com Patreon) for dedicated rate limits.
#         team_id: 134778                # Optional, default 134778 (Southampton FC) -- a TheSportsDB team ID, NOT football-data.org's
#         poll_interval_secs: 300        # Optional, default 300
# log_file: /logs/hypervolt-agile-scheduler.log   # Omit to log to console only. In Docker, /logs is bind-mounted from /home/pi/.log/hypervolt-agile.
# log_level: INFO                # Console log level (default: INFO). File log level is always INFO.
