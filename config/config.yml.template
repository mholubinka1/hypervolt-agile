# led:
#   enabled: true                  # Set to false to pause LED control without losing config. Omit the whole `led:` block to disable entirely.
#   brightness: 0.5                # >0 and <=1, LED brightness whenever the car is plugged in (default: 0.5) -- not just while actively charging. LEDs always go fully off when unplugged, regardless of this value.
#   built_in_themes:                # Native charger effects, priority under custom_themes and extensions. Listing an effect here is what enables it -- omit one entirely to leave it off. Dates use MM-DD, or "MM-DD HH:MM" for a specific time (default 00:00).
#     - effect: halloween_mode
#       start: "10-31"
#       end: "11-01 06:00"
#     - effect: christmas_mode
#       start: "12-24"
#       end: "12-31 06:00"
#     - effect: party_mode
#       start: "12-31 06:00"
#       end: "01-01 06:00"
#   custom_themes:                 # Static colour patterns for dates that matter to you, priority over built-in seasonal effects. Add your own led_effects/*.yaml (in Docker: /home/pi/.config/hypervolt-agile/led_effects/, since only config.yml itself is bind-mounted) and a matching entry here, e.g.:
#     - effect: my_theme              # led_effects/my_theme.yaml
#       start: "MM-DD"
#       end: "MM-DD"
#   extensions:                     # Dynamic themes resolved by a Python module you register, priority over custom_themes and built-ins. A saints_fc reference implementation ships in this repo's extensions/ -- to use it, copy extensions/saints_fc.py into a SEPARATE directory from config.yml (in Docker: /home/pi/.config/hypervolt-agile-extensions/, mounted to /extensions -- see --extensions-dir) and uncomment the entry below.
#     - name: saints_fc                # extensions/saints_fc.py -- lights up red/white on any Southampton FC match day
#       config:
#         api_key: "3"                   # Optional, default "3" -- TheSportsDB's free shared key, no signup needed. Swap for a personal key (thesportsdb.com Patreon) for dedicated rate limits.
#         team_id: 134778                # Optional, default 134778 (Southampton FC) -- a TheSportsDB team ID, NOT football-data.org's
#         poll_time: "23:00"             # Optional, default "23:00" -- local (Europe/London) 24-hour time to check for tomorrow's fixture. Also checked once for *today* on startup, so a same-day deploy/restart doesn't miss a match happening that day.
# log_file: /logs/hypervolt-agile-scheduler.log   # Omit to log to console only. In Docker, /logs is bind-mounted from /home/pi/.log/hypervolt-agile.
# log_level: INFO                # Console log level (default: INFO). File log level is always INFO.
